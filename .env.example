# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit the real .env file.
# The bot reads variables with the BOT_ prefix; "__" denotes a nested section.
# ---------------------------------------------------------------------------

# PostgreSQL container credentials (used by docker-compose and the bot)
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=twitch_bot

# Twitch application credentials (https://dev.twitch.tv/console/apps)
BOT_TWITCH__CLIENT_ID=your-client-id
BOT_TWITCH__CLIENT_SECRET=your-client-secret
BOT_TWITCH__BOT_USERNAME=your-bot-account
# EventSub needs numeric IDs, not login names. The bot can listen in several
# channels: provide JSON arrays of equal length (one entry per channel).
BOT_TWITCH__BOT_ID=123456789
BOT_TWITCH__CHANNEL=["first-channel","second-channel"]
BOT_TWITCH__CHANNEL_ID=["987654321","123123123"]
# OAuth is handled by the bot: tokens are stored in PostgreSQL and refreshed
# automatically. Register this exact redirect URL in your Twitch application.
BOT_TWITCH__OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback
BOT_TWITCH__OAUTH_BIND_HOST=0.0.0.0
BOT_TWITCH__OAUTH_PORT=8080
BOT_TWITCH__OAUTH_SCOPES=["user:read:chat","user:write:chat","user:bot","channel:bot"]
# Each broadcaster authorizes these scopes so app-token sends get the bot badge.
BOT_TWITCH__CHANNEL_SCOPES=["channel:bot"]

# PostgreSQL (the host is overridden to "db" inside docker-compose)
BOT_DATABASE__HOST=localhost
BOT_DATABASE__PORT=5432
BOT_DATABASE__USER=bot
BOT_DATABASE__PASSWORD=change-me
BOT_DATABASE__NAME=twitch_bot

# Named OpenAI-compatible endpoints. Keys are endpoint names used by
# !chatset model <endpoint>/<model>. api_key is redacted in logs and reprs.
# default_model is the fallback when a channel has no !chatset model set yet.
BOT_LLM__ENDPOINTS={"openrouter":{"base_url":"https://openrouter.ai/api/v1","api_key":"your-openrouter-key","default_model":"openai/gpt-4o-mini"},"local":{"base_url":"http://localhost:11434/v1","api_key":"none","default_model":"llama3"}}
# Defaults to the first endpoint above when omitted.
BOT_LLM__DEFAULT_ENDPOINT=openrouter
BOT_LLM__TIMEOUT_SECONDS=30
BOT_LLM__MAX_RESPONSE_CHARS=500

# Logging
BOT_LOGGING__LEVEL=INFO

# Outbound chat pacing (shared across all channels and modules)
BOT_CHAT__MIN_INTERVAL_SECONDS=1.5
BOT_CHAT__QUEUE_MAXSIZE=100
BOT_CHAT__MAX_RETRIES=3
BOT_CHAT__BACKOFF_BASE_SECONDS=1.0
# Case-insensitive phrases that must never be sent to chat.
BOT_CHAT__BANNED_PHRASES=[]
BOT_CHAT__BANNED_PHRASE_REPLACEMENT="[System] Blocklisted phrase detected in reply... Aborting."

# Comma-free JSON list of modules to load.
BOT_ENABLED_MODULES=["chat_logger","quotes","ecount","lines","ai_chat","lynyxia","livepass","trivia","pyramid","unused_emotes","emote_sets"]

# Twitch user IDs (numeric strings) allowed to run admin commands.
BOT_ADMIN_USER_IDS=[]

# Live-mode command gating. While a channel is live, only users on that
# channel's !livepass list (plus the owner/admins) may use bot commands.
# exempt_commands always work, so the bot can still be managed while live.
BOT_LIVE__ENABLED=true
BOT_LIVE__EXEMPT_COMMANDS=["chatset","livepass","lynyxia"]

# Per-module configuration (JSON objects).
#
# AI chat: personas live in ./personas (Docker mounts it read-only). They are
# re-read on every !chatset prompt and AI reply, so edits need no restart.
# Tools are enabled by listing their names; set searxng_url to enable web search.
BOT_MODULE__AI_CHAT={"personas_dir":"personas","default_persona":"generic.md","cooldown_seconds":5,"max_context_messages":20,"max_thread_messages":20,"max_response_tokens":500,"max_tool_rounds":5,"tools":["web_search","chat_messages","list_chatters","sample_chatter_messages","search_chat","channel_history"],"searxng_url":null,"searxng_timeout_seconds":10,"searxng_max_results":5,"log_path":"logs/ai.log"}
#
# Emote counter: default window when no timeframe is given, and a hard cap on
# requested timeframes (both in days). Timeframe syntax: <number>y|w|d|m.
BOT_MODULE__ECOUNT={"default_days":365,"max_days":3650}
#
# Message counter: strftime format for the "since <date>" part of !lines (UTC).
BOT_MODULE__LINES={"date_format":"%Y-%m-%d %H:%M:%S"}
#
# Users excluded from !rq (Twitch logins or numeric user IDs). Requests for
# these users reply "User not found.", and their messages are omitted from
# random quotes.
BOT_MODULE__QUOTES={"excluded_users":[]}
#
# Trivia: category JSON files live in ./trivia (Docker mounts it read-only).
# Files are re-read on every !trivia command, so new files work without a restart.
BOT_MODULE__TRIVIA={"directory":"trivia","file_prefix":"category_","file_suffix":".json","timeout_seconds":60,"hint_delay_seconds":10,"similarity_threshold":0.9}
#
# Pyramid watcher: passive module, no commands. Reacts to completed emote
# pyramids (3-wide and up) and collapses after the peak. Set enabled=false to
# silence it without changing BOT_ENABLED_MODULES. Reactions are suppressed
# while a channel is live.
BOT_MODULE__PYRAMID={"enabled":true}
#
# Shared settings for HTML reports (!unusedemotes and !emotesets). The URL
# prefix is public (no trailing slash needed). Reports are written to
# ./reports/<channel-login>/ via a writable Docker mount; chat replies
# substitute {url} and {channel}.
BOT_REPORTS={"url_prefix":"https://reports.example.com","reports_dir":"reports","api_base":"https://7tv.io/v3","timeout_seconds":30}
#
# Unused emotes: cutoff syntax is <number><y|w|d|m>.
BOT_MODULE__UNUSED_EMOTES={"default_cutoff":"365d","default_threshold":10}
#
# Emote sets: compares the channel's owned 7TV sets (up to max_sets).
BOT_MODULE__EMOTE_SETS={"filename":"emotesets.html","max_sets":10}
